{
  "name": "six-it/perspective-editor",
  "license": "GPL-3.0-or-later",
  "type": "pimcore-bundle",
  "description": "6IT Pimcore Perspective Editor",
  "config": {
    "sort-packages": true,
    "preferred-install": {
      "six-it/pimcore-source": "source",
      "*": "dist"
    }
  },
  "prefer-stable": true,
  "minimum-stability": "dev",
  "require": {
    "php": "~8.4.0",
    "six-it/admin-ui-classic-bundle": "^2.0",
    "six-it/pimcore-source": "^2.0.5",
    "symfony/http-foundation": "^7.4"
  },
  "require-dev": {
    "phpstan/phpstan": "^1.10.5",
    "phpunit/phpunit": "^10.5 || ^11.0",
    "codeception/codeception": "^5.0.10",
    "codeception/module-symfony": "^3.1.1",
    "codeception/module-asserts": "^3"
  },
  "autoload": {
    "psr-4": {
      "Pimcore\\Bundle\\PerspectiveEditorBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Pimcore\\Bundle\\PerspectiveEditorBundle\\Tests\\": "tests"
    },
    "files": [
      "kernel/Kernel.php"
    ]
  },
  "extra": {
    "pimcore": {
      "bundles": [
        "Pimcore\\Bundle\\PerspectiveEditorBundle\\PimcorePerspectiveEditorBundle"
      ]
    }
  }
}
